import tkinter as tk

# Create main window
window = tk.Tk()
window.title("Tkinter Calculator")
window.geometry("300x400")

# Entry field
entry = tk.Entry(window, width=20, font=("Arial", 20), justify="right")
entry.grid(row=0, column=0, columnspan=4, padx=10, pady=20)


# Function to display button value
def button_click(value):
    entry.insert(tk.END, value)


# Function to calculate result
def calculate():
    try:
        result = eval(entry.get())
        entry.delete(0, tk.END)
        entry.insert(0, result)
    except:
        entry.delete(0, tk.END)
        entry.insert(0, "Error")


# Function to clear entry
def clear():
    entry.delete(0, tk.END)


# Buttons
buttons = [
    ("7", 1, 0),
    ("8", 1, 1),
    ("9", 1, 2),
    ("/", 1, 3),

    ("4", 2, 0),
    ("5", 2, 1),
    ("6", 2, 2),
    ("*", 2, 3),

    ("1", 3, 0),
    ("2", 3, 1),
    ("3", 3, 2),
    ("-", 3, 3),

    ("0", 4, 0),
    ("C", 4, 1),
    ("=", 4, 2),
    ("+", 4, 3)
]

for text, row, column in buttons:
    if text == "=":
        button = tk.Button(
            window,
            text=text,
            width=5,
            height=2,
            command=calculate
        )
    elif text == "C":
        button = tk.Button(
            window,
            text=text,
            width=5,
            height=2,
            command=clear
        )
    else:
        button = tk.Button(
            window,
            text=text,
            width=5,
            height=2,
            command=lambda value=text: button_click(value)
        )

    button.grid(row=row, column=column, padx=5, pady=5)


# Start application
window.mainloop()
```

